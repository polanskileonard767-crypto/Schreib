{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schreib Glyph",
  "type": "object",
  "required": ["character", "variants"],
  "properties": {
    "character": { "type": "string", "minLength": 1 },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "paths"],
        "properties": {
          "id": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "advanceWidth": { "type": "number" }
        }
      }
    }
  }
}
